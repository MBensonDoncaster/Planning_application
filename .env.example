COMPOSE_PROJECT_NAME=planning-application
POSTGRES_DB=template
POSTGRES_USER=template
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
APP_PORT=3000
APP_NAME=Planning
APP_ORIGIN=https://planning.example.com
# Container URL (host development uses apps/backend/.env with localhost).
# URL-encode reserved characters if you change the password. Keep these values aligned.
DATABASE_URL=postgresql://template:local-development-only@postgres:5432/template
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_SCOPE=
TRUST_PROXY=false
# compose.dev.yaml explicitly overrides this profile to local.
DEPLOYMENT_PROFILE=production
BUSINESS_TIMEZONE=Europe/London
INGESTION_MAX_BODY_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=5242880
ZIP_MAX_ENTRIES=1000
JSON_MAX_DEPTH=100
GEOJSON_MAX_POSITIONS=100000
EXPORT_MAX_SELECTION=500
EXPORT_MAX_BYTES=104857600
EXPORT_GENERATION_TIMEOUT_MS=30000
EXPORT_DOWNLOAD_TIMEOUT_MS=120000
IDEMPOTENCY_RETENTION_DAYS=30
API_KEY_DEFAULT_EXPIRY_DAYS=90
API_KEY_MAX_EXPIRY_DAYS=365
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_KEY_MAX=30
RATE_LIMIT_INTEGRATION_IP_MAX=120
