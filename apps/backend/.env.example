NODE_ENV=development
DEPLOYMENT_PROFILE=local
HOST=127.0.0.1
PORT=3000
APP_NAME=Planning
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://template:local-development-only@localhost:5432/template
AUTH_MODE=TEST_USER
TEST_USER_SUBJECT=local:developer
TEST_USER_EMAIL=developer@example.test
TEST_USER_NAME=Local Developer
# Switch AUTH_MODE to ENTRA to test real SSO. Register this origin as an SPA redirect URI.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_SCOPE=
LOG_LEVEL=info
BUSINESS_TIMEZONE=Europe/London
INGESTION_MAX_BODY_BYTES=10485760
UPLOAD_MAX_FILE_BYTES=5242880
ZIP_MAX_ENTRIES=1000
JSON_MAX_DEPTH=100
GEOJSON_MAX_POSITIONS=100000
EXPORT_MAX_SELECTION=500
EXPORT_MAX_BYTES=104857600
EXPORT_GENERATION_TIMEOUT_MS=30000
EXPORT_DOWNLOAD_TIMEOUT_MS=120000
IDEMPOTENCY_RETENTION_DAYS=30
API_KEY_DEFAULT_EXPIRY_DAYS=90
API_KEY_MAX_EXPIRY_DAYS=365
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_KEY_MAX=30
RATE_LIMIT_INTEGRATION_IP_MAX=120
