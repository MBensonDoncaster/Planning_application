{
  "name": "template-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=@template/backend",
    "dev:frontend": "npm run dev --workspace=@template/frontend",
    "typecheck": "npm run prisma:generate --workspace=@template/backend && npm run typecheck --workspaces",
    "test": "npm run prisma:generate --workspace=@template/backend && npm run test --workspaces",
    "lint": "eslint .",
    "build": "npm run build --workspace=@template/frontend && npm run build --workspace=@template/backend",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build",
    "audit:security": "npm audit",
    "migrate:status": "npm run prisma:migrate:status --workspace=@template/backend",
    "migrate:deploy": "npm run prisma:migrate:deploy --workspace=@template/backend",
    "admin:bootstrap": "npm run admin:bootstrap --workspace=@template/backend --",
    "start": "npm start --workspace=@template/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.4.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.5"
    }
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
